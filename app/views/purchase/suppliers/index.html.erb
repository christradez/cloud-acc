<h1>Suppliers</h1>

<%= link_to 'New Supplier', new_purchase_supplier_path %>

<table>
  <thead>
    <tr>
      <th>Name</th>
      <th>Tax ID</th>
      <th colspan="3"></th>
    </tr>
  </thead>

  <tbody>
    <% @suppliers.each do |supplier| %>
      <tr>
        <td><%= supplier.name %></td>
        <td><%= supplier.tax_id %></td>
        <td><%= link_to 'Show', purchase_supplier_path(supplier) %></td>
        <td><%= link_to 'Edit', edit_purchase_supplier_path(supplier) %></td>
        <td><%= link_to 'Destroy', purchase_supplier_path(supplier), method: :delete, data: { confirm: 'Are you sure?' } %></td>
      </tr>
    <% end %>
  </tbody>
</table>
