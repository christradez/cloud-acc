<div class="nested-fields">
  <div class="field">
    <%= f.label :item_id %><br>
    <%= f.collection_select :item_id, current_user.tenant.items, :id, :name %>
  </div>
  <div class="field">
    <%= f.label :quantity %><br>
    <%= f.number_field :quantity %>
  </div>
  <div class="field">
    <%= f.label :unit_price %><br>
    <%= f.text_field :unit_price %>
  </div>
  <div class="field">
    <%= f.label :total %><br>
    <%= f.text_field :total %>
  </div>
  <%= link_to_remove_association "Remove Item", f %>
</div>
