<h1>Payslips for <%= @employee.name %></h1>

<%= link_to 'New Payslip', new_employee_payslip_path(@employee) %>

<table>
  <thead>
    <tr>
      <th>Date</th>
      <th>Gross Salary</th>
      <th>Deductions</th>
      <th>Net Salary</th>
      <th colspan="3"></th>
    </tr>
  </thead>

  <tbody>
    <% @payslips.each do |payslip| %>
      <tr>
        <td><%= payslip.date %></td>
        <td><%= payslip.gross_salary %></td>
        <td><%= payslip.deductions %></td>
        <td><%= payslip.net_salary %></td>
        <td><%= link_to 'Show', employee_payslip_path(@employee, payslip) %></td>
        <td><%= link_to 'Edit', edit_employee_payslip_path(@employee, payslip) %></td>
        <td><%= link_to 'Destroy', employee_payslip_path(@employee, payslip), method: :delete, data: { confirm: 'Are you sure?' } %></td>
      </tr>
    <% end %>
  </tbody>
</table>

<%= link_to 'Back to Employees', employees_path %>
