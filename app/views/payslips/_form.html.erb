    <%= f.label :gross_salary %><br>
    <%= f.text_field :gross_salary %>
  </div>
  <div class="field">
    <%= f.label :deductions %><br>
    <%= f.text_field :deductions %>
  </div>
  <div class="field">
    <%= f.label :net_salary %><br>
