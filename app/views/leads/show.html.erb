<p>
  <strong>Name:</strong>
  <%= @lead.name %>
</p>

<p>
  <strong>Email:</strong>
  <%= @lead.email %>
</p>

<p>
  <strong>Phone:</strong>
  <%= @lead.phone %>
</p>

<p>
  <strong>Status:</strong>
  <%= @lead.status %>
</p>

<hr>

<h2>Opportunities</h2>
<%= link_to 'New Opportunity', new_lead_opportunity_path(@lead) %>
<table>
  <thead>
    <tr>
      <th>Name</th>
      <th>Stage</th>
      <th>Amount</th>
      <th>Close Date</th>
      <th colspan="3"></th>
    </tr>
  </thead>
  <tbody>
    <% @lead.opportunities.each do |opportunity| %>
      <tr>
        <td><%= opportunity.name %></td>
        <td><%= opportunity.stage %></td>
        <td><%= opportunity.amount %></td>
        <td><%= opportunity.close_date %></td>
        <td><%= link_to 'Show', [@lead, opportunity] %></td>
        <td><%= link_to 'Edit', edit_lead_opportunity_path(@lead, opportunity) %></td>
        <td><%= link_to 'Destroy', [@lead, opportunity], method: :delete, data: { confirm: 'Are you sure?' } %></td>
      </tr>
    <% end %>
  </tbody>
</table>


<%= link_to 'Edit', edit_lead_path(@lead) %> |
<%= link_to 'Back', leads_path %>
