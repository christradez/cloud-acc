<h1>Customers</h1>

<%= link_to 'New Customer', new_sales_customer_path %>

<table>
  <thead>
    <tr>
      <th>Name</th>
      <th>Type</th>
      <th>Tax ID</th>
      <th>Payment Terms</th>
      <th>Currency</th>
      <th colspan="3"></th>
    </tr>
  </thead>

  <tbody>
    <% @customers.each do |customer| %>
      <tr>
        <td><%= customer.name %></td>
        <td><%= customer.customer_type %></td>
        <td><%= customer.tax_id %></td>
        <td><%= customer.payment_terms %></td>
        <td><%= customer.currency %></td>
        <td><%= link_to 'Show', sales_customer_path(customer) %></td>
        <td><%= link_to 'Edit', edit_sales_customer_path(customer) %></td>
        <td><%= link_to 'Destroy', sales_customer_path(customer), method: :delete, data: { confirm: 'Are you sure?' } %></td>
      </tr>
    <% end %>
  </tbody>
</table>
