<h1>Bills</h1>

<%= link_to 'New Bill', new_bill_path %>

<table>
  <thead>
    <tr>
      <th>Supplier</th>
      <th>Status</th>
      <th>Date</th>
      <th>Due Date</th>
      <th>Total</th>
      <th colspan="3"></th>
    </tr>
  </thead>

  <tbody>
    <% @bills.each do |bill| %>
      <tr>
        <td><%= bill.supplier.name %></td>
        <td><%= bill.status %></td>
        <td><%= bill.date %></td>
        <td><%= bill.due_date %></td>
        <td><%= bill.total %></td>
        <td><%= link_to 'Show', bill %></td>
        <td><%= link_to 'Edit', edit_bill_path(bill) %></td>
        <td><%= link_to 'Destroy', bill, method: :delete, data: { confirm: 'Are you sure?' } %></td>
      </tr>
    <% end %>
  </tbody>
</table>
