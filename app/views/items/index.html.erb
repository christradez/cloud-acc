<h1>Items</h1>

<%= link_to 'New Item', new_item_path %>

<table>
  <thead>
    <tr>
      <th>Name</th>
      <th>SKU</th>
      <th>Category</th>
      <th>Brand</th>
      <th>Tax Code</th>
      <th>Base UOM</th>
      <th>Quantity</th>
      <th colspan="3"></th>
    </tr>
  </thead>

  <tbody>
    <% @items.each do |item| %>
      <tr>
        <td><%= item.name %></td>
        <td><%= item.sku %></td>
        <td><%= item.category %></td>
        <td><%= item.brand %></td>
        <td><%= item.tax_code.name %></td>
        <td><%= item.base_uom %></td>
        <td><%= item.quantity %></td>
        <td><%= link_to 'Show', item %></td>
        <td><%= link_to 'Edit', edit_item_path(item) %></td>
        <td><%= link_to 'Destroy', item, method: :delete, data: { confirm: 'Are you sure?' } %></td>
      </tr>
    <% end %>
  </tbody>
</table>
